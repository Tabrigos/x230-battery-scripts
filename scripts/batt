#!/usr/bin/env bash
# Usage:
#   batt 80         -> Imposta profilo longevità (start 40, stop 80)
#   batt 100        -> Sblocca (start 0, stop 100)
#   batt status     -> Mostra le soglie correnti
#   batt enable     -> Abilita il profilo longevità all'avvio
#   batt disable    -> Disabilita il profilo longevità all'avvio
#   batt help       -> Mostra questo aiuto

set -euo pipefail

# Trova tutti i percorsi delle batterie che supportano il controllo della soglia di carica.
find_battery_paths() {
  local found_paths=""
  for bat_path in /sys/class/power_supply/BAT*; do
    # Il nome del file può variare, verifichiamo i più comuni
    if [ -e "$bat_path/charge_control_end_threshold" ] || [ -e "$bat_path/charge_stop_threshold" ]; then
      found_paths="$found_paths $bat_path"
    fi
  done

  if [ -z "$found_paths" ]; then
    echo "Errore: Nessuna batteria compatibile trovata in /sys/class/power_supply/BAT*." >&2
    return 1
  fi
  
  echo "$found_paths" | sed 's/^ *//' # Rimuove lo spazio iniziale
}

# Funzione per scrivere nei file di /sys con sudo
write_sys_file() {
    local value=$1
    local file=$2
    # La richiesta di password avverrà solo la prima volta
    echo "$value" | sudo tee "$file" > /dev/null
}

# Determina il nome corretto per i file di controllo della carica
get_threshold_files() {
    local bat_path=$1
    if [ -e "$bat_path/charge_control_end_threshold" ]; then
        echo "$bat_path/charge_control_start_threshold $bat_path/charge_control_end_threshold"
    elif [ -e "$bat_path/charge_stop_threshold" ]; then
        echo "$bat_path/charge_start_threshold $bat_path/charge_stop_threshold"
    else
        return 1
    fi
}

check_for_tlp() {
    if systemctl is-active --quiet tlp.service; then
        echo "ATTENZIONE: Il servizio TLP è attivo. Potrebbe sovrascrivere le impostazioni di questo script." >&2
        echo "Si consiglia di disabilitare la gestione delle soglie di carica in /etc/tlp.conf." >&2
        echo "" >&2
    fi
}

# --- Comandi Principali ---

set_thresholds() {
    local start_value=$1
    local stop_value=$2
    local profile_name=$3
    
    local BAT_PATHS
    BAT_PATHS=$(find_battery_paths)
    
    check_for_tlp
    echo "Impostazione profilo '$profile_name': start=${start_value}%, stop=${stop_value}%"
    echo "Per modificare i file di sistema, potrebbe essere richiesta la password di sudo."

    for bat_path in $BAT_PATHS; do
        local bat_name
        bat_name=$(basename "$bat_path")
        
        local files
        files=$(get_threshold_files "$bat_path") || {
            echo "Impossibile determinare i file di soglia per $bat_name. Salto." >&2
            continue
        }
        
        local start_file end_file
        start_file=$(echo "$files" | cut -d' ' -f1)
        end_file=$(echo "$files" | cut -d' ' -f2)

        echo "  -> Applico a $bat_name..."
        write_sys_file "$start_value" "$start_file"
        write_sys_file "$stop_value" "$end_file"
    done
    echo "Profilo '$profile_name' applicato con successo."
}

show_status() {
    local BAT_PATHS
    BAT_PATHS=$(find_battery_paths)

    echo "Stato attuale delle batterie:"
    for bat_path in $BAT_PATHS; do
        local bat_name
        bat_name=$(basename "$bat_path")
        
        local files
        files=$(get_threshold_files "$bat_path") || {
            echo "--- $bat_name (file di soglia non trovati) ---" >&2
            continue
        }

        local start_file end_file
        start_file=$(echo "$files" | cut -d' ' -f1)
        end_file=$(echo "$files" | cut -d' ' -f2)

        local s e status
        s=$(cat "$start_file" 2>/dev/null || echo "?")
        e=$(cat "$end_file" 2>/dev/null || echo "?")
        status=$(cat "$bat_path/status" 2>/dev/null || echo "Sconosciuto")

        echo "--- $bat_name ---"
        echo "  Soglie:  start=${s}%, stop=${e}%"
        echo "  Stato:   $status"
    done
    
    local service_status="disabilitato"
    if systemctl is-enabled --quiet "$SERVICE_NAME" 2>/dev/null; then
        service_status="abilitato"
    fi
    echo ""
    echo "Servizio all'avvio ($SERVICE_NAME): $service_status"
    check_for_tlp
}

# --- Gestione Argomenti ---

SERVICE_NAME="set-battery-threshold.service"

case "${1-}" in
  80)
    set_thresholds 40 80 "Longevità"
    ;;
  100)
    # Per sbloccare la carica, alcune batterie usano 96, altre 0. Usiamo 96 per compatibilità.
    set_thresholds 96 100 "Sblocco Totale"
    ;;
  status)
    show_status
    ;;
  enable)
    check_for_tlp
    echo "Per abilitare il servizio di sistema, potrebbe essere richiesta la password di sudo."
    sudo systemctl enable "$SERVICE_NAME"
    echo "Profilo longevità abilitato all'avvio."
    ;;
  disable)
    check_for_tlp
    echo "Per disabilitare il servizio di sistema, potrebbe essere richiesta la password di sudo."
    sudo systemctl disable "$SERVICE_NAME"
    echo "Profilo longevità disabilitato all'avvio."
    ;;
  help|-h|--help|"")
    cat <<'MSG'
Uso:
  batt 80         → Imposta profilo longevità (start 40%, stop 80%)
  batt 100        → Sblocca totale (start 96%, stop 100%)
  batt status     → Mostra le soglie correnti per tutte le batterie
  batt enable     → Abilita il profilo longevità all'avvio
  batt disable    → Disabilita il profilo longevità all'avvio
  batt help       → Mostra questo messaggio
MSG
    ;;
  *)
    echo "Argomento non valido: $1" >&2
    echo "Usa: batt [80|100|status|enable|disable|help]" >&2
    exit 2
    ;;
esac
